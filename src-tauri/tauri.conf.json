{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PingPong Manager",
  "version": "0.1.0",
  "identifier": "com.datjikun.pingpongmanager",
  "build": {
    "beforeBuildCommand": "npm run desktop:pack",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "PingPong Manager",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
